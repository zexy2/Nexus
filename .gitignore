# ==============================================
# DEPENDENCIES
# ==============================================
node_modules/
.pnpm-store/
.yarn/

# ==============================================
# BUILD OUTPUTS
# ==============================================
.next/
dist/
build/
out/
.turbo/
*.tsbuildinfo

# ==============================================
# ENVIRONMENT FILES - NEVER COMMIT!
# ==============================================
.env
.env.*
!.env.example
!.env.production.example
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ==============================================
# IDE & EDITOR
# ==============================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/*.example
.idea/
.claude/
*.swp
*.swo
*~

# ==============================================
# SECRETS & CREDENTIALS - CRITICAL!
# ==============================================
cookies.txt
*.cookie
*.cookies
*.session
*.pem
*.key
*.cert
*.p12
secrets.json
credentials.json
mcp.json
.vscode/mcp.json
serviceAccount*.json
*-credentials.json

# ==============================================
# OS FILES
# ==============================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ==============================================
# LOGS & DEBUG
# ==============================================
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log

# ==============================================
# TESTING
# ==============================================
coverage/
.nyc_output/
testsprite_tests/tmp/
playwright-report/
test-results/

# ==============================================
# TEMPORARY FILES
# ==============================================
*.tmp
*.temp
.cache/
tmp/
temp/
