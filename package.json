{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Living Plan impact review, Kanban alignment, and AI workflow workspace demo",
  "scripts": {
    "dev:local": "bash scripts/dev-local.sh",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "db:push": "pnpm --filter @nexus/database db:push",
    "db:migrate": "node scripts/baseline-drizzle-migrations.mjs && pnpm db:migrate:raw",
    "db:migrate:raw": "pnpm --filter @nexus/database db:migrate",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "smoke:prod": "bash scripts/smoke-prod.sh",
    "db:studio": "pnpm --filter @nexus/database db:studio",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "eslint": "^9",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "^1.14.4",
      "@tiptap/core": "3.17.0",
      "@tiptap/pm": "3.17.0",
      "@babel/core": "^7.29.6",
      "ajv@>=8.0.0 <9.0.0": "^8.18.0",
      "brace-expansion@>=2.0.0 <3.0.0": "^2.0.3",
      "defu": "^6.1.5",
      "fast-uri": "^3.1.2",
      "form-data": "^4.0.6",
      "minimatch@>=9.0.0 <10.0.0": "^9.0.7",
      "markdown-it@>=14.0.0 <15.0.0": "^14.2.0",
      "picomatch": "^4.0.4",
      "postcss@>=8.0.0 <9.0.0": "^8.5.10",
      "protobufjs": "^7.6.4",
      "rollup": "^4.59.0",
      "shell-quote": "^1.8.4",
      "uuid@11.1.0": "11.1.1",
      "yaml@>=2.0.0 <3.0.0": "^2.8.3",
      "ws@>=8.0.0 <9.0.0": "^8.21.0"
    }
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
