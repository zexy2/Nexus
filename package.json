{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Living Plan impact review, Kanban alignment, and AI workflow workspace demo",
  "scripts": {
    "dev:local": "bash scripts/dev-local.sh",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "db:push": "pnpm --filter @nexus/database db:push",
    "db:migrate": "node scripts/baseline-drizzle-migrations.mjs && pnpm db:migrate:raw",
    "db:migrate:raw": "pnpm --filter @nexus/database db:migrate",
    "demo:seed-user": "node scripts/seed-demo-user.mjs",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "smoke:prod": "bash scripts/smoke-prod.sh",
    "db:studio": "pnpm --filter @nexus/database db:studio",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "eslint": "^9",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@langchain/core": "^0.3.80"
    }
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@hocuspocus/extension-database": "^3.4.3",
    "@hocuspocus/extension-logger": "^3.4.3",
    "@hocuspocus/provider": "^3.4.3",
    "@hocuspocus/server": "^3.4.3",
    "@hookform/resolvers": "^5.2.2",
    "@opentelemetry/auto-instrumentations-node": "^0.68.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.210.0",
    "@opentelemetry/resources": "^2.4.0",
    "@opentelemetry/sdk-node": "^0.210.0",
    "@opentelemetry/sdk-trace-base": "^2.4.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "postgres": "^3.4.8",
    "react-countup": "^6.5.3",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.6.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29",
    "zustand": "^5.0.10"
  }
}
