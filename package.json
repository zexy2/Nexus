{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Living Plan impact review, Kanban alignment, and AI workflow workspace demo",
  "scripts": {
    "dev:local": "bash scripts/dev-local.sh",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "db:push": "pnpm --filter @nexus/database db:push",
    "db:migrate": "node scripts/baseline-drizzle-migrations.mjs && pnpm db:migrate:raw",
    "db:migrate:raw": "pnpm --filter @nexus/database db:migrate",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "smoke:prod": "bash scripts/smoke-prod.sh",
    "smoke:integrations": "bash scripts/smoke-integrations.sh",
    "db:studio": "pnpm --filter @nexus/database db:studio",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "eslint": "^9",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
