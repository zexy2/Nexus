POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexus
APP_COMMIT_SHA=set-from-git-rev-parse-head-during-deploy
REQUIRE_INTEGRATIONS_HEALTH=true
REQUIRE_INTEGRATION_PROVIDERS=github

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
COLLAB_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://your-domain.com
APP_URL=https://your-domain.com
AUTH_TRUSTED_ORIGINS=https://your-domain.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=https://your-domain.com/api/integrations/linear/callback
LINEAR_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_COLLABORATION_URL=wss://your-domain.com/collab
COLLABORATION_HEALTH_URL=http://collaboration:1234
WEB_BIND=127.0.0.1
CSP_ENFORCE=true
COLLAB_MAX_PAYLOAD_BYTES=1048576
YJS_SNAPSHOT_UPDATE_THRESHOLD=100
YJS_SNAPSHOT_INTERVAL_MS=30000

TEMPORAL_NAMESPACE=default

# Worker drain window on SIGTERM/SIGINT (e.g. "45 seconds", "1m"). In-flight
# activities get this long to finish before the worker exits; keep it below the
# container stop timeout (docker-compose.prod.yml stop_grace_period: 60s).
WORKER_SHUTDOWN_GRACE_TIME=45 seconds

# Reverse proxies appending to X-Forwarded-For (Caddy only = 1, CDN + Caddy = 2).
TRUSTED_PROXY_COUNT=1

# Token for detailed /api/health output (config, latencies, commit). Send as
# "x-health-token" or "Authorization: Bearer". Without it, only per-service
# status is public (verified admins also see details). openssl rand -hex 32
HEALTH_CHECK_TOKEN=

# First-run onboarding cutoff (ISO 8601). Accounts created before this instant
# are treated as existing users and never see the onboarding modal. Unset or
# invalid -> built-in default 2026-11-23T00:00:00Z. Read by the web server only.
ONBOARDING_LAUNCH_AT=

DEMO_MODE=true
PUBLIC_SIGNUP_ENABLED=false
ADMIN_EMAILS=your-email@example.com
DEMO_ACCESS_CODE=
DEMO_SESSION_TTL_MINUTES=60
DEMO_MAX_ACTIVE_SESSIONS=25
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_PUBLIC_SIGNUP_ENABLED=false
NEXT_PUBLIC_DEMO_ACCESS_CODE_REQUIRED=false

AI_ENABLED=true
GEMINI_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
AI_GLOBAL_DAILY_LIMIT=5000
AI_GLOBAL_PER_MINUTE_LIMIT=120
AI_USER_DAILY_LIMIT=200
AI_USER_PER_MINUTE_LIMIT=20
AI_WORKFLOW_DAILY_LIMIT=50
AI_CHAT_DAILY_LIMIT=200
AI_DEMO_DAILY_LIMIT=3
AI_DEMO_PER_MINUTE_LIMIT=1
AI_DEMO_WORKFLOW_DAILY_LIMIT=2
AI_DEMO_CHAT_DAILY_LIMIT=1
AI_ADMIN_DAILY_LIMIT=400
AI_ADMIN_PER_MINUTE_LIMIT=40
AI_ADMIN_WORKFLOW_DAILY_LIMIT=100
AI_ADMIN_CHAT_DAILY_LIMIT=400
AI_MAX_STEPS_PER_WORKFLOW=4
