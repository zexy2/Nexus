#!/usr/bin/env bash
# Fake `curl` for scripts/tests/deploy.test.sh: /api/health answers 200.
echo "curl $*" >> "$STUB_STATE/calls"
out=""
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -o ]]; then out="$2"; shift; fi
  shift
done
if [[ -n "$out" ]]; then echo '{"status":"healthy"}' > "$out"; fi
printf 200
