# Environment Configuration
# Copy to .env.local and configure your values
# NEVER commit .env.local to version control!

# ===========================================
# DATABASE
# ===========================================
POSTGRES_USER=nexus
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=nexus
POSTGRES_PORT=5433
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# ===========================================
# SYNC ENGINE
# v1 uses API-backed sync/offline queue. Zero cache is deferred until schema compatibility is restored.
# ===========================================
ZERO_AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_ZERO_SERVER=http://localhost:4848
ZERO_UPSTREAM_DB=${DATABASE_URL}

# ===========================================
# AI PROVIDERS - Get your API keys from:
# ===========================================

# Gemini (Google AI): https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# Tavily (Search): https://tavily.com/
TAVILY_API_KEY=

# ===========================================
# LOCAL / PRIVATE AI (Ollama) — optional
# Point at a local Ollama server's OpenAI-compatible endpoint to run AI on your
# own hardware. With AI_LOCAL_ONLY=true, NO document content leaves the host:
# chat/agents/workflows use the local model, web search is disabled, and
# external embeddings are skipped (RAG falls back to local keyword search).
# ===========================================
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# AI_LOCAL_ONLY=false

# Shared server-managed AI quotas
AI_WORKFLOWS_PER_DAY=25
AI_CHAT_MESSAGES_PER_DAY=100
AI_ENABLED=true
AI_GLOBAL_DAILY_LIMIT=100
AI_GLOBAL_PER_MINUTE_LIMIT=4
AI_USER_DAILY_LIMIT=5
AI_USER_PER_MINUTE_LIMIT=2
AI_WORKFLOW_DAILY_LIMIT=3
AI_CHAT_DAILY_LIMIT=10
AI_ADMIN_DAILY_LIMIT=50
AI_ADMIN_PER_MINUTE_LIMIT=4
AI_ADMIN_WORKFLOW_DAILY_LIMIT=20
AI_ADMIN_CHAT_DAILY_LIMIT=100
AI_MAX_STEPS_PER_WORKFLOW=5

# Public portfolio demo controls
DEMO_MODE=false
PUBLIC_SIGNUP_ENABLED=true
ADMIN_EMAILS=
DEMO_EMAIL=demo@nexus.local
DEMO_PASSWORD=change-me-demo-password
DEMO_SEED_TOKEN=
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_PUBLIC_SIGNUP_ENABLED=true
NEXT_PUBLIC_DEMO_EMAIL=demo@nexus.local

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Shared secret for realtime collaboration access tokens. Must be identical for
# the web app (issues tokens) and the collaboration server (verifies them).
# Generate with: openssl rand -base64 32
COLLAB_AUTH_SECRET=

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Content-Security-Policy: ships as Report-Only by default (won't break the UI).
# Review violation reports, then set CSP_ENFORCE=true to enforce.
CSP_ENFORCE=false

# ===========================================
# AI PROVIDERS (configure at least one)
# ===========================================
# Google AI: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Tavily Search: https://tavily.com/
TAVILY_API_KEY=

# ===========================================
# OBSERVABILITY (optional)
# ===========================================
# LangSmith: https://smith.langchain.com/
LANGSMITH_API_KEY=

# Langfuse: https://langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===========================================
# WORKFLOW ENGINE
# ===========================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ===========================================
# PRODUCTION
# ===========================================
# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://your-domain.com
AUTH_TRUSTED_ORIGINS=http://localhost:3000
