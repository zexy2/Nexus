# Environment Configuration
# Copy to .env.local and configure your values
# NEVER commit .env.local to version control!

# ===========================================
# DATABASE
# ===========================================
POSTGRES_USER=nexus
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=nexus
POSTGRES_PORT=5433
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# ===========================================
# SYNC ENGINE
# ===========================================
ZERO_AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_ZERO_SERVER=http://localhost:4848
ZERO_UPSTREAM_DB=${DATABASE_URL}

# ===========================================
# AI PROVIDERS - Get your API keys from:
# ===========================================

# Gemini (Google AI): https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# Tavily (Search): https://tavily.com/
TAVILY_API_KEY=

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# AI PROVIDERS (configure at least one)
# ===========================================
# Google AI: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Tavily Search: https://tavily.com/
TAVILY_API_KEY=

# ===========================================
# OBSERVABILITY (optional)
# ===========================================
# LangSmith: https://smith.langchain.com/
LANGSMITH_API_KEY=

# Langfuse: https://langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===========================================
# WORKFLOW ENGINE
# ===========================================
TEMPORAL_ADDRESS=localhost:7233

# ===========================================
# PRODUCTION
# ===========================================
# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://your-domain.com
