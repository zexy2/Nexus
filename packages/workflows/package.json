{
  "name": "@nexus/workflows",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./activities": {
      "import": "./dist/activities.js",
      "types": "./dist/activities.d.ts"
    },
    "./workflows": {
      "import": "./dist/workflows.js",
      "types": "./dist/workflows.d.ts"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@temporalio/activity": "1.18.2",
    "@temporalio/client": "1.18.2",
    "@temporalio/worker": "1.18.2",
    "@temporalio/workflow": "1.18.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nexus/typescript-config": "workspace:*",
    "@temporalio/testing": "1.18.2",
    "@types/node": "^22.15.7",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.4",
    "vitest": "^4.1.12"
  }
}
